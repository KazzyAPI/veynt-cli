{
  "name": "veynt",
  "version": "0.1.1",
  "private": true,
  "description": "AI-native pre-commit engineering reviewer for Git diffs",
  "license": "MIT",
  "bin": {
    "veynt": "./packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:cli": "pnpm --filter veynt-cli run build",
    "publish:cli": "pnpm run build:cli && cd packages/cli && npm publish",
    "test": "vitest run",
    "lint": "pnpm -r run lint",
    "veynt": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@veynt/findings": "workspace:*",
    "@veynt/git": "workspace:*",
    "@veynt/review-engine": "workspace:*",
    "@veynt/config": "workspace:*",
    "@veynt/core": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
